{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kcb-ics",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*"]
  }
}
